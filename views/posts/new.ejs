<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>New Post - DOS Games Blog</title>
  <link rel="stylesheet" href="/stylesheets/style.css">
  <link rel="stylesheet" href="/stylesheets/partials.css">
</head>
<body>
  <%- include('../partials/_navbar.ejs') %>
  
  <main>
    <h1>New Post</h1>
    
    <form action="/posts" method="POST">
      <div>
        <label for="title">Title:</label>
        <input type="text" name="title" id="title" required>
      </div>

      <div>
        <label for="body">Post Body:</label>
        <textarea name="body" id="body" required></textarea>
      </div>

      <div>
        <label for="coverImage">Cover Image URL:</label>
        <input type="text" name="coverImage" id="coverImage" placeholder="https://example.com/image.jpg">
      </div>

      <div>
        <label for="gameFile">Game File URL (.jsdos):</label>
        <input type="text" name="gameFile" id="gameFile" placeholder="https://example.com/game.jsdos">
      </div>

      <button type="submit">Create Post</button>
    </form>
    
    <a href="/posts" class="btn btn-secondary">Cancel</a>
  </main>

  <%- include('../partials/_footer.ejs') %>
</body>
</html>